<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <ApplicationIcon>Assets/App.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <UseWinUI>true</UseWinUI>
        <EnabledXamlOptionalChanges>DefaultStyleOptimizations,OptimizeApplyStyles</EnabledXamlOptionalChanges>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>
        <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <PublishAot>true</PublishAot>
        <TrimMode>link</TrimMode>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <EnableMsixTooling>true</EnableMsixTooling>
    </PropertyGroup>

    <PropertyGroup>
        <ImmersiveTBResourceLanguages>en-US;zh-CN</ImmersiveTBResourceLanguages>
        <SatelliteResourceLanguages>$(ImmersiveTBResourceLanguages)</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="BetterWinUI.PageActivation.DependencyInjection"/>
        <PackageReference Include="BetterWinUI.Navigation.Frame"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls"/>
        <PackageReference Include="CsToml.Extensions.Configuration"/>
        <PackageReference Include="CsToml.Generator">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="H.NotifyIcon.WinUI"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Windows.CsWinRT"/>
        <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences"/>
        <PackageReference Include="Microsoft.WindowsAppSDK.Runtime"/>
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI"/>
        <PackageReference Include="Vortice.Direct3D11"/>
        <PackageReference Include="Vortice.DXGI"/>
        <PackageReference Include="WinUIEx"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Interop\NativeMethods.txt"/>
        <AdditionalFiles Include="Interop\NativeMethods.json"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ImmersiveTB.Core\ImmersiveTB.Core.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="appsettings.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Content Include="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix"/>
    </ItemGroup>
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <Target Name="FilterUnsupportedWinUiPublishLanguages" AfterTargets="ComputeFilesToPublish">
        <PropertyGroup>
            <_ImmersiveTBResourceLanguagePattern>$([System.String]::Copy('$(ImmersiveTBResourceLanguages)').Replace(';', '|'))</_ImmersiveTBResourceLanguagePattern>
        </PropertyGroup>
        <ItemGroup>
            <_UnsupportedWinUiPublishResource
                    Include="@(ResolvedFileToPublish)"
                    Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
                        '%(ResolvedFileToPublish.RelativePath)',
                        '^(?!(?:$(_ImmersiveTBResourceLanguagePattern))[\\/])[^\\/]+[\\/][^\\/]+\.mui$',
                        System.Text.RegularExpressions.RegexOptions.IgnoreCase))"/>
            <_StaleUnsupportedWinUiPublishDirectory
                    Include="$([System.IO.Path]::GetDirectoryName('%(_UnsupportedWinUiPublishResource.RelativePath)'))"
                    Condition="'%(_UnsupportedWinUiPublishResource.Extension)' == '.mui'"/>
            <ResolvedFileToPublish Remove="@(_UnsupportedWinUiPublishResource)"/>
        </ItemGroup>
        <RemoveDir
                Directories="@(_StaleUnsupportedWinUiPublishDirectory->'$(PublishDir)%(Identity)')"/>
    </Target>
</Project>
